# ============================================================================
#  GrapheneOS-SM-A245F — single source of truth for the kernel build
# ============================================================================
#  Everything the build scripts and GitHub Actions need is defined here.
#  Edit ONLY this file to retarget the build at a different firmware base.
# ----------------------------------------------------------------------------

# --- Target device -----------------------------------------------------------
DEVICE_MODEL="SM-A245F"
DEVICE_CODENAME="a24"
DEVICE_SOC="MediaTek Helio G99 (MT6789)"
DEVICE_ARCH="arm64"

# --- Firmware compatibility base ---------------------------------------------
# The kernel vendor modules are built against the vendor partition of a
# SPECIFIC firmware build. Flashing a kernel built for one base onto another
# base is unsupported and may not boot.
#
# Default base: A245FXXS9DYG1  (Android 15 / One UI 7.0, bootloader binary 9)
#   CSC   : TUR (Turkey) - any CSC with the same binary is compatible
#   Build : AP3A.240905.015.A2.A245FXXS9DYG1
#   Patch : 2025-08-01
BASE_FIRMWARE="A245FXXS9DYG1"
BASE_ANDROID="15"
BASE_ONEUI="7.0"
BASE_BINARY="9"
BASE_SECURITY_PATCH="2025-08-01"
BASE_CSC_EXAMPLE="TUR"

# --- Kernel source -----------------------------------------------------------
KERNEL_REPO="https://github.com/oliplusmzr/android_kernel_samsung_a245f.git"
KERNEL_BRANCH="A245FXXS9DYG1"      # Samsung OSRC drop matching BASE_FIRMWARE
KERNEL_DIR="kernel-5.10"
KERNEL_DEFCONFIG="a24_defconfig"    # full defconfig (a24_00_defconfig is a fragment)
KERNEL_VERSION="5.10.226"
KMI_GENERATION="9"
KMI_BRANCH="android12-5.10"

# --- Toolchain ---------------------------------------------------------------
# Must match the compiler recorded in the Samsung defconfig, otherwise the
# kernel may fail to reproduce the expected layout/behaviour.
TOOLCHAIN_REPO="https://github.com/LineageOS/android_prebuilts_clang_kernel_linux-x86_clang-r416183b.git"
TOOLCHAIN_TAG="clang-r416183b"
CLANG_BIN_SUBDIR="bin"

# --- Root solutions ----------------------------------------------------------
# Variants produced by the build:
#   vanilla      -> stock kernel, no root
#   kernelsu     -> KernelSU-Next integrated   (poqdavid fork, ref "dev")
#   kernelsu-up  -> upstream KernelSU integrated (tiann)
#
# BakaSU was dropped: this kernel tree has no SUSFS support
# (0 files reference susfs anywhere in kernel-5.10), and BakaSU's value over
# plain KernelSU is exactly its SUSFS integration. Without SUSFS in the kernel
# it would behave as a plain KernelSU with an extra dependency.
# Official upstream. poqdavid's fork was tried first but it lags far behind
# (newest tag v3.0.0 while upstream is at v3.4.2) and it publishes no manager
# APK, so a kernel built from it could never be paired with a versionCode-
# matching app -- which is a hard requirement for these releases.
KSU_NEXT_REPO="https://github.com/KernelSU-Next/KernelSU-Next.git"
KSU_NEXT_REF="dev"                 # upstream development branch
KSU_UPSTREAM_REPO="https://github.com/tiann/KernelSU.git"
KSU_UPSTREAM_REF="main"

# Upstream reference releases, used to cross-check that the version code we
# integrate really matches the manager APK we ship. Kernel and app MUST match
# exactly, or the manager will report "unsupported" / refuse to load.
#
# Observed upstream version codes at time of writing:
#   KernelSU-Next v3.4.2 -> 33355   (asset: KernelSU_Next_v3.4.2_33355-release.apk)
#   KernelSU      v3.3.1 -> 32680   (asset: KernelSU_v3.3.1_32680-release.apk)
KSU_NEXT_UPSTREAM_API="https://api.github.com/repos/KernelSU-Next/KernelSU-Next/releases/latest"
KSU_UPSTREAM_API="https://api.github.com/repos/tiann/KernelSU/releases/latest"

# Where the version code lives.
#
# Upstream KernelSU keeps a header with the code baked in.
#
# KernelSU-Next does NOT: kernel/Kbuild computes it at build time as
#     30000 + $(git rev-list --count HEAD)
# so this path will not exist there and build-kernel.sh falls back to
# reproducing that arithmetic from the clone. Keep the header path for the
# variants that do provide one.
KSU_VERSION_HEADER="kernel/include/ksu.h"

# --- Output ------------------------------------------------------------------
OUT_DIR="out"
DIST_DIR="dist"
